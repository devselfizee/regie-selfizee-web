NEXT_PUBLIC_API_URL=http://localhost:3003/api

# Keycloak : vide en local = pas de connexion (comme l'API sans KEYCLOAK_URL)
NEXT_PUBLIC_KEYCLOAK_URL=
# Prod : NEXT_PUBLIC_KEYCLOAK_URL=https://plateform-auth.orkessidev.com
NEXT_PUBLIC_KEYCLOAK_REALM=konitys
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=regie-selfizee

# En-tête et barre latérale communs Konitys, chargés en ligne (navigation locale si indisponible)
NEXT_PUBLIC_PLATEFORM_URL=https://plateform.orkessi.com

# Autocomplétion d'adresse des fiches lieu (Google Places), facultative : même clé que l'application stock,
# avec l'adresse du front autorisée dans les restrictions de la clé (Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Studio de cadres (fiche événement → Gabarits → « Ouvrir le studio ») ───
# Variables lues à l'exécution par les routes /editor-api du front (serveur Next), jamais envoyées au navigateur.

# Catalogue de modèles, menus de contenu, polices : le back-office booth (Cake). Défaut : https://booth.selfizee.fr
MODELS_BACKEND_URL=https://booth.selfizee.fr
# Compte de service booth : depuis le 07/09/2026, le catalogue exige un jeton (sans ce compte, catalogue vide, 401)
BOOTH_API_USERNAME=
BOOTH_API_PASSWORD=
# Banques d'images des panneaux Images et Fonds, facultatives (vide : panneaux sans résultats)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Variables NEXT_PUBLIC du studio, intégrées au build (à passer aussi en build args, cf. Dockerfile), facultatives :
# API publique de bibliotheques-back (éléments, illustrations, photos) ; vide = source désactivée
NEXT_PUBLIC_BIBLIOTHEQUES_URL=
# Préfixe des anciens fichiers /uploads/... du serveur de selfizee-booth-ui ; vide = chemins laissés tels quels
NEXT_PUBLIC_STUDIO_BACKEND_URL=
